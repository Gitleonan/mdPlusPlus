{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "md++",
  "mainBinaryName": "md++",
  "version": "0.5.0",
  "identifier": "com.easymd.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:14300",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "md++",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http: mdpp-img: http://mdpp-img.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Gitleonan/mdPlusPlus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzODhBMTlERjRDOTlGNzkKUldSNW44bjBuYUdJTTZOWVlOOVBVZVUxQStHSW1JUWR1bG1keFprTnhnVWlQWFFUV05XQlJYK2MK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "../scripts/installer.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "description": "Markdown File"
      }
    ]
  }
}
